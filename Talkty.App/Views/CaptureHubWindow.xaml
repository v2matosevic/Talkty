<Window x:Class="Talkty.App.Views.CaptureHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dictation destination" Width="560" Height="480" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Zinc950Brush}"
        Foreground="{StaticResource Zinc200Brush}" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Dictate into an ADE draft" Foreground="{StaticResource Zinc200Brush}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Choose the workspace and agent. Your words join its draft without using the clipboard or sending a message."
                       TextWrapping="Wrap" Margin="0,10,0,16" Foreground="{StaticResource Zinc400Brush}"/>
        </StackPanel>
        <ComboBox Grid.Row="1" x:Name="Destinations" DisplayMemberPath="Label" MinHeight="34" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="2" x:Name="Status" Text="Loading destinations…" TextWrapping="Wrap" Foreground="{StaticResource Zinc400Brush}" Margin="0,0,0,16"/>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Saved deliveries" Foreground="{StaticResource Zinc200Brush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" x:Name="Saved" Background="{StaticResource Zinc900Brush}" Foreground="{StaticResource Zinc200Brush}" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Destination.Label}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="450" Foreground="{StaticResource Zinc400Brush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <WrapPanel Grid.Row="4" Margin="0,18,0,0">
            <Button x:Name="UseButton" Content="Use this draft" Click="Use_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
            <Button Content="Dictate at cursor" Click="Cursor_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
            <Button x:Name="RetryButton" Content="Retry saved" Click="Retry_Click" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/>
        </WrapPanel>
    </Grid>
</Window>
